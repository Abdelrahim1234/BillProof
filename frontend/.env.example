# Server-only backend origin. Do not prefix this variable with NEXT_PUBLIC_.
BACKEND_API_URL=http://127.0.0.1:8000

# Optional projector settings.
PUBLIC_URL=
# Optional 12-32 character capability code. Leave blank to generate a random
# room whenever /present loads; do not use a predictable value in production.
ROOM_CODE=

# Browser upload guard; keep below BFF_MAX_REQUEST_BYTES.
NEXT_PUBLIC_MAX_UPLOAD_MB=4

# Server-side proxy safety limits.
BFF_TIMEOUT_MS=60000
BFF_MAX_REQUEST_BYTES=5242880
BFF_MAX_RESPONSE_BYTES=10485760
