APP_ENV=development
ALLOW_REAL_PHI=false
STORE_RAW_DOCUMENTS=false

# Explicit storage selection. File storage is local/dev-safe and remains the
# default even if MONGODB_URI happens to exist in the process environment.
STORAGE_BACKEND=file
PRIVATE_DB_NAME=billproof_private
PUBLIC_DB_NAME=billproof_public

# Optional real MongoDB/Atlas backend. All values are server-only. A non-local
# host requires STORAGE_BACKEND=mongodb and MONGODB_ALLOW_REMOTE=true.
MONGODB_URI=
MONGODB_PRIVATE_DATABASE=billproof_private
MONGODB_PUBLIC_DATABASE=billproof_public
MONGODB_ALLOW_REMOTE=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Keep false for API, inventory, and dry-run commands. A reviewed quarantine
# apply against MongoDB requires this plus explicit CLI confirmations.
MONGODB_CLEANUP_WRITES_ENABLED=false

CASE_TOKEN_SECRET=
HMAC_IDENTIFIER_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20
CASE_TTL_HOURS=24
ORIGINAL_RETENTION_HOURS=24
CASE_RETENTION_DAYS=30
CHAT_RETENTION_HOURS=24
DEMO_MODE=true
LOG_LEVEL=INFO

OCR_PROVIDER=local
EXPLANATION_PROVIDER=deterministic
EXPLANATION_MODEL=

EXTERNAL_PDF_EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Powers the optional "explain this line" / "ask a question" feature.
# Only ever called for a case that set external_processing_consent=true --
# see docs/02 and services/explain.py.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
LLM_API_KEY=
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=
KMS_KEY_ID=

MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001

CMS_PROVIDER_DATASET_ID=xubh-q36u
CMS_INPATIENT_DATASET_UUID=
CMS_OUTPATIENT_DATASET_UUID=

TURQUOISE_ENABLED=false
TURQUOISE_CLIENT_ID=
TURQUOISE_CLIENT_SECRET=
TURQUOISE_ORGANIZATION_ID=

ACTIVE_MARKET_ID=nrv_core_v1
ACTIVE_MARKET_FACILITIES=LewisGale Hospital Montgomery,Carilion New River Valley Medical Center
